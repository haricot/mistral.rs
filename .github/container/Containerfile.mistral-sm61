FROM nvidia/cuda:12.9.2-devel-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential libssl-dev protobuf-compiler pkg-config cmake clang \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:/usr/local/cuda/bin:${PATH}
RUN curl --proto "=https" --tlsv1.2 --fail --silent --show-error \
    https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.99.0 \
    && rm /tmp/rustup-init.sh \
    && cargo --version && rustc --version && nvcc --version
