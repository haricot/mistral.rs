ARG BASE_IMAGE=nvidia/cuda:12.9.2-devel-ubuntu24.04
FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/haricot/mistral.rs"
ARG RUST_TOOLCHAIN=1.99.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential libssl-dev protobuf-compiler pkg-config cmake clang zstd \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN} \
       --component rustfmt --component clippy \
    && rm /tmp/rustup-init.sh
ENV PATH=/opt/rustup/toolchains/${RUST_TOOLCHAIN}-x86_64-unknown-linux-gnu/bin:/opt/tools:/usr/local/cuda/bin:/usr/bin:/bin
COPY install-tools.py /tmp/install-tools.py
COPY config.json /tmp/config.json
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && python3 /tmp/install-tools.py /tmp/config.json /opt/tools \
    && rm -rf /var/lib/apt/lists/* /tmp/config.json /tmp/install-tools.py \
    && cargo --version && rustc --version && cargo-nextest nextest --version && sccache --version
